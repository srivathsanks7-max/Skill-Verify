# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# App
FLASK_SECRET_KEY=replace_with_a_long_random_secret
CREDENTIAL_SIGNING_SECRET=replace_with_another_long_random_secret
FRONTEND_URL=http://localhost:5173
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
COOKIE_SECURE=false

# Hosted Judge0. Set this to your hosted Judge0 URL.
# For a RapidAPI Judge0 subscription, use:
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_RAPIDAPI_KEY=...
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_URL=https://ce.judge0.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=

# Optional: if you export the Colab skill model to the repo, point here.
SKILL_MODEL_PATH=

# Assessment settings
VERIFICATION_SHELF_LIFE_DAYS=90
MAX_GITHUB_REPOS=15
